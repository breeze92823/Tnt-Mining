# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false
# Starting cash for the player (defaults to 320 when unset)
VITE_START_CASH=320

# Starting TNT carry capacity (defaults to 5 when unset)
VITE_CARRY_MAX=5

# Starting damage for the player (defaults to 1 when unset)
VITE_START_DAMAGE=1

# Colyseus server (../Tnt-Mining-backend) for saved progress and the leaderboards.
# Dev builds (`npm run dev`, `build:dev`) use _DEV (default ws://localhost:2567);
# production builds use _MAIN (empty = stay solo). Both come from GitHub repo
# variables SERVER_URL_DEV / SERVER_URL_MAIN in the deploy workflow.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=
